# Kopieer naar .env.production en vul echte waarden in. Nooit committen.
#
# DOMAIN mag één of twee hostnamen bevatten (Caddy maakt voor elke naam een
# certificaat aan). Gebruik beide als de site op www én zonder www bereikbaar
# moet zijn, bijvoorbeeld:
#   DOMAIN=app.jouwdomein.nl, www.jouwdomein.nl
DOMAIN=beheer.diligence-almere.nl
APP_URL=https://beheer.diligence-almere.nl

# Verplicht in productie
COOKIE_SECURE=true
ENFORCE_2FA=true
SESSION_IDLE_MINUTES=60
RATE_LIMIT_SECRET=vervang-door-een-lange-willekeurige-waarde

# Eerste beheerder bij een lege database. In productie (NODE_ENV=production)
# zijn beide verplicht en start de app niet zonder: er bestaat dan nooit een
# account met een standaardwachtwoord. Het wachtwoord moet minimaal 12 tekens
# hebben.
SEED_ADMIN_EMAIL=beheer@jouwdomein.nl
SEED_ADMIN_NAME=Beheerder
SEED_ADMIN_PASSWORD=vervang-door-een-sterk-wachtwoord
# In productie worden demogegevens nooit aangemaakt, ook niet met true.
# false = alleen het beheerdersaccount, geen verzonnen deelnemers en uitjes.
SEED_DEMO_DATA=true

# Database (SQLite-bestand). In Docker regelt docker-compose.yml dit pad.
DILIGENCE_DB_PATH=/app/data/diligence.db

# E-mail (optioneel; zonder sleutel blijft de wachtrij in demo-stand)
BREVO_API_KEY=
EMAIL_FROM=info@diligence-almere.nl
EMAIL_FROM_NAME=Stichting Diligence Almere

# Back-ups. BACKUP_KEY genereer je met: openssl rand -base64 32
# Bewaar de sleutel buiten de server; zonder sleutel is een back-up niets waard.
BACKUP_KEY=
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
