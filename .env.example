# Kopieer naar .env.production en vul echte waarden in. Nooit committen.
DOMAIN=beheer.diligence-almere.nl
APP_URL=https://beheer.diligence-almere.nl

# Verplicht in productie
COOKIE_SECURE=true
ENFORCE_2FA=true
SESSION_IDLE_MINUTES=60
RATE_LIMIT_SECRET=vervang-door-een-lange-willekeurige-waarde

# E-mail (optioneel; zonder sleutel blijft de wachtrij in demo-stand)
BREVO_API_KEY=
EMAIL_FROM=info@diligence-almere.nl
EMAIL_FROM_NAME=Stichting Diligence Almere

# Alleen voor scripts/backup.mjs en scripts/restore.mjs op de host.
# Genereer met: openssl rand -base64 32
BACKUP_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
